---
import { FOOTER_COLUMNS, SITE } from '@data/site';
import logo from '@/assets/images/logo-v2.jpeg';
import { Image } from 'astro:assets';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-support">
    <div class="container">
      <div>
        <h3><span aria-hidden="true">☕</span> <span data-i18n="chabondhu-heading">Help Us Keep Youth Education 100% Free</span></h3>
        <p data-i18n="footer-chabondhu-text">
          Onnoy is an independent youth initiative in Bangladesh. We keep all our workshops, workbooks, and cyber support 100% free. Support our volunteer team with a cup of tea on ChaBondhu.
        </p>
      </div>
      <a href={SITE.chabondhu} target="_blank" rel="noopener" class="btn-chabondhu" data-i18n="chabondhu-btn">Support on ChaBondhu ☕</a>
    </div>
  </div>

  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo"><Image src={logo} alt="" width={40} height={40} loading="lazy" /><span>{SITE.name}</span></a>
        <p data-i18n="footer-address">Empowering Independent Thinkers for Bangladesh</p>
        <p class="text-xs" data-i18n="footer-location">{SITE.location}</p>
        <div class="social-links">
          <a href={SITE.facebook} target="_blank" rel="noopener" aria-label="Onnoy on Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
          </a>
          <a href={SITE.youtube} target="_blank" rel="noopener" aria-label="Onnoy on YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener" aria-label="Chat with Onnoy on WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>
      {FOOTER_COLUMNS.map((col) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul role="list">{col.links.map((l) => <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.name} · <span data-i18n="footer-tagline">Connecting Necessary Dots</span></span>
      <span>
        <a href="/privacy">Privacy</a> · <a href="/sitemap-index.xml">Sitemap</a> · <a href={SITE.chabondhu} target="_blank" rel="noopener">Support on ChaBondhu ☕</a>
      </span>
    </div>
  </div>
</footer>
