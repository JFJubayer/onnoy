---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/course-player.css';
---

<BaseLayout title="Course 1: Digital Safety" description="Course 1: Digital Safety — Learn core digital safety principles, password protection, and account security with Onnoy (অন্বয়).">
  <header class="hero" id="main" tabindex="-1">
          <div class="container fade-in">
              <h1>Digital Safety Basics</h1>
              <p>Module 1: Protecting your digital life in Bangladesh.</p>
          </div>
      </header>
  
      <main class="container section-gap">
          <div class="card" style="padding: 0; overflow: hidden; max-width: 900px; margin: 0 auto;">
              <div style="background: #000; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; color: white;">
                  <div class="text-center">
                      <div style="display: flex; justify-content: center; margin-bottom: 15px;">
                          <div class="video-play-btn">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                          </div>
                      </div>
                      <p>Video coming soon</p>
                  </div>
              </div>
              <div style="padding: 30px;">
                  <h2>About this module</h2>
                  <p>In this video, we cover the essentials of account security, recognizing phishing attempts, and safe browsing habits specific to the Bangladeshi context.</p>
                  
                  <div style="margin-top: 30px; display: flex; gap: 15px;">
                      <button type="button" class="btn btn-secondary" disabled>Worksheet Coming Soon</button>
                      <a href="/courses" class="btn btn-outline">Back to Courses</a>
                  </div>
              </div>
          </div>
      </main>

</BaseLayout>
