---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import BadgeCriteriaCard from '@components/BadgeCriteriaCard.astro';
import StatusMessage from '@components/StatusMessage.astro';
import '@/styles/pages/badges-inline.css';

const badgeTiers = [
  {
    theme: 'green' as const,
    tier: 'Tier 1 · Knowledge Foundation',
    title: 'Informed',
    titleBn: 'অবহিত নাগরিক',
    image: '/assets/images/badges/informed.png',
    description: 'Certifies that a student understands digital footprint dynamics, online attention algorithms, phishing scams, and ethical AI practices.',
    criteria: [
      'Complete all <strong>5 Level 1 Digital Citizenship modules</strong> (Attention Literacy, Misinformation, Scam Safety, AI Integrity, Digital Footprint).',
      'Pass all interactive knowledge checkpoints with at least <strong>80% accuracy</strong>.',
      'Complete the baseline self-assessment reflection.',
    ],
    ctaHref: '/modules',
    ctaLabel: 'Start Level 1 Modules →',
  },
  {
    theme: 'sky' as const,
    tier: 'Tier 2 · Practical Action',
    title: 'Aware',
    titleBn: 'সচেতন ডিফেন্ডার',
    image: '/assets/images/badges/aware.png',
    description: 'Certifies active application of critical judgment in the real world: debunking misinformation, running privacy audits, and building healthier digital habits.',
    criteria: [
      'Must have already earned the <strong>Tier 1: Informed Badge</strong>.',
      'Successfully complete and submit <strong>3 Level 2 real-world missions</strong>:<br>— <em>Fact-check a viral social claim with 2+ trusted sources.</em><br>— <em>Conduct a family or friend screen audit and digital agreement.</em><br>— <em>Audit an AI tool for hallucinations or bias.</em>',
      'Submission reviewed and approved by the Onnoy mentor team.',
    ],
    ctaHref: '/modules',
    ctaLabel: 'Explore Level 2 Missions →',
  },
  {
    theme: 'rose' as const,
    tier: 'Tier 3 · Community Leadership',
    title: 'Guardian',
    titleBn: 'ডিজিটাল অভিভাবক ও লিডার',
    image: '/assets/images/badges/guardian.png',
    description: 'The premier honor for student ambassadors who advocate for digital ethics, guide peers against scams, and foster independent thinking across Bangladesh.',
    criteria: [
      'Must have earned both <strong>Informed</strong> and <strong>Aware</strong> badges.',
      'Complete all <strong>4 Level 2 Missions</strong> with exemplary performance.',
      'Lead an awareness discussion or share an Onnoy workbook in your school, college, or community group.',
      'Direct approval and verification by Onnoy Founders and Academic Council.',
    ],
    ctaHref: '/profile',
    ctaLabel: 'Check Profile & Eligibility →',
  },
];
---

<BaseLayout title="Verified Badges & Criteria" description="Explore Onnoy's 3 verified student badges, view badge samples, and see the exact criteria required to earn them." wrapMain>
  <PageHero title="Verified Badges & Criteria" subtitle="ভেরিফাইড ব্যাজ ও অর্জনের মানদণ্ড" mainTarget={false}>
    <p>Earn official digital credentials by completing modules, conducting real-world missions, and demonstrating leadership.</p>
  </PageHero>

  <section class="section-gap container">
    <div class="badges-intro">
      <div class="section-label">Credibility & Recognition</div>
      <h2 class="section-title">The 3 Verified Onnoy Badges</h2>
      <p>Each badge represents an escalation in skill, from foundational knowledge to hands-on action and community leadership. Badges are tied to your unique Onnoy ID and can be featured on your academic profile, resume, and social media.</p>
    </div>

    <div class="cards-grid badges-grid">
      {badgeTiers.map((badge) => <BadgeCriteriaCard {...badge} />)}
    </div>

    <aside class="credential-callout" aria-labelledby="credential-callout-title">
      <div class="credential-callout__icon" aria-hidden="true">🛡️</div>
      <div class="credential-callout__copy">
        <h3 id="credential-callout-title">How Credential Verification Works</h3>
        <p>Every badge is linked to a unique student identifier such as <code>ONNOY-748291</code>. Teachers, employers, and admission panels can verify achievements through Onnoy's public verification portal.</p>
      </div>
      <a href="/profile" class="btn btn-green">View My Profile & Badges →</a>
    </aside>

    <section class="card card--flat badge-verifier" id="verify" aria-labelledby="verify-title">
      <h3 id="verify-title">Verify a Student's Badges</h3>
      <p>Enter an Onnoy ID to confirm which credentials a student has earned. No personal contact details are shown.</p>
      <form id="verifyForm" class="cluster badge-verifier-form" novalidate>
        <label for="verifyId" class="sr-only">Onnoy ID</label>
        <input id="verifyId" class="form-control" placeholder="ONNOY-123456" pattern="ONNOY-\d{6}" required autocomplete="off" />
        <button type="submit" class="btn btn-green">Verify</button>
      </form>
      <StatusMessage id="verifyResult" class="alert hidden badge-verifier-result" />
    </section>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('verifyForm');
        const input = document.getElementById('verifyId');
        const out = document.getElementById('verifyResult');
        const labels = { informed: 'Informed', aware: 'Aware', guardian: 'Guardian' };
        const show = (cls, html) => { out.className = 'status-message alert badge-verifier-result ' + cls; out.innerHTML = html; };
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const id = input.value.trim().toUpperCase();
          if (!/^ONNOY-\d{6}$/.test(id)) { show('alert--warning', 'Please enter an ID in the format <b>ONNOY-123456</b>.'); return; }
          if (!window.supabaseClient) { show('alert--danger', 'Verification service is unavailable right now.'); return; }
          show('', 'Checking…');
          const { data, error } = await window.supabaseClient.rpc('verify_badge', { p_unique_id: id });
          if (error) { show('alert--danger', 'Verification failed. Please try again later.'); return; }
          const row = Array.isArray(data) ? data[0] : data;
          if (!row) { show('alert--warning', `No student found with ID <b>${id}</b>.`); return; }
          const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
          const badges = (row.badges || []).map((badge) => `<span class="badge badge--result">${labels[badge] || esc(badge)}</span>`).join(' ');
          show('alert--success', `<div><b>${esc(row.unique_id)}</b>${row.full_name ? ' · ' + esc(row.full_name) : ''}${row.school_name ? ' · ' + esc(row.school_name) : ''}<br>${badges || '<em>No badges earned yet.</em>'}</div>`);
        });
      });
    </script>
  </Fragment>
</BaseLayout>