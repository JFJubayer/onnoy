---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/badges-inline.css';
---

<BaseLayout title="Verified Badges & Criteria" description="Explore Onnoy's 3 verified student badges, view badge samples, and see the exact criteria required to earn them.">
  <!-- 2. Hero Section -->
      <header class="hero" id="main" tabindex="-1">
          <div class="container fade-in">
              <h1>Verified Badges & Criteria</h1>
              <p>ভেরিফাইড ব্যাজ ও অর্জনের মানদণ্ড</p>
              <p>Earn official digital credentials by completing modules, conducting real-world missions, and demonstrating leadership.</p>
          </div>
      </header>
  
      <!-- 3. Badges Showcase Section -->
      <section class="section-gap container">
          <div class="text-center" style="max-width: 780px; margin: 0 auto 40px auto;">
              <div class="section-label" style="text-transform: uppercase; font-weight: 700; letter-spacing: 1px; color: var(--green); margin-bottom: 8px;">Credibility & Recognition</div>
              <h2 class="section-title">The 3 Verified Onnoy Badges</h2>
              <p style="color: var(--ink-mid); font-size: 1.05rem; line-height: 1.6;">
                  Each badge represents an escalation in skill — from foundational knowledge to hands-on action and community leadership. Badges are tied to your unique Onnoy ID and can be featured on your academic profile, resume, and social media.
              </p>
          </div>
  
          <div class="cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
              
              <!-- Badge 1: Informed -->
              <div class="badge-sample-card" style="border-top: 5px solid #06d6a0;">
                  <div>
                      <div class="badge-image-container">
                          <img src="/assets/images/badges/informed.png" alt="Informed Badge Sample">
                      </div>
                      <div style="text-align: center; margin-bottom: 16px;">
                          <span class="badge-tier-tag" style="background: rgba(6, 214, 160, 0.15); color: #059669;">Tier 1 · Knowledge Foundation</span>
                          <h3 style="font-size: 1.5rem; margin: 6px 0 4px 0;">Informed</h3>
                          <div style="color: #059669; font-weight: 600; font-size: 0.95rem;">অবহিত নাগরিক</div>
                      </div>
                      
                      <p style="color: var(--ink-mid); font-size: 0.92rem; line-height: 1.5; margin-bottom: 16px;">
                          Certifies that a student understands digital footprint dynamics, online attention algorithms, phishing scams, and ethical AI practices.
                      </p>
  
                      <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--ink); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Earning Criteria:</h4>
                      <ul class="criteria-list">
                          <li style="color: var(--ink);">Complete all <strong>5 Level 1 Digital Citizenship modules</strong> (Attention Literacy, Misinformation, Scam Safety, AI Integrity, Digital Footprint).</li>
                          <li>Pass all interactive knowledge checkpoints with at least <strong>80% accuracy</strong>.</li>
                          <li>Complete the baseline self-assessment reflection.</li>
                      </ul>
                  </div>
  
                  <div>
                      <a href="/modules" class="btn btn-green" style="width: 100%; text-align: center; display: block;">Start Level 1 Modules →</a>
                  </div>
              </div>
  
              <!-- Badge 2: Aware -->
              <div class="badge-sample-card" style="border-top: 5px solid #2563eb;">
                  <div>
                      <div class="badge-image-container">
                          <img src="/assets/images/badges/aware.png" alt="Aware Badge Sample">
                      </div>
                      <div style="text-align: center; margin-bottom: 16px;">
                          <span class="badge-tier-tag" style="background: rgba(37, 99, 235, 0.15); color: #2563eb;">Tier 2 · Practical Action</span>
                          <h3 style="font-size: 1.5rem; margin: 6px 0 4px 0;">Aware</h3>
                          <div style="color: #2563eb; font-weight: 600; font-size: 0.95rem;">সচেতন ডিফেন্ডার</div>
                      </div>
                      
                      <p style="color: var(--ink-mid); font-size: 0.92rem; line-height: 1.5; margin-bottom: 16px;">
                          Certifies active application of critical judgment in the real world: debunking misinformation, running privacy audits, and building healthier digital habits.
                      </p>
  
                      <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--ink); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Earning Criteria:</h4>
                      <ul class="criteria-list">
                          <li style="color: var(--ink);">Must have already earned the <strong>Tier 1: Informed Badge</strong>.</li>
                          <li>Successfully complete and submit <strong>3 Level 2 real-world missions</strong>:
                              <br>— <em>Fact-check a viral social claim with 2+ trusted sources.</em>
                              <br>— <em>Conduct a family/friend screen audit & digital agreement.</em>
                              <br>— <em>Audit an AI tool for hallucinations or bias.</em>
                          </li>
                          <li>Submission reviewed and approved by the Onnoy mentor team.</li>
                      </ul>
                  </div>
  
                  <div>
                      <a href="/modules" class="btn" style="background: #2563eb; color: #FFF; width: 100%; text-align: center; display: block;">Explore Level 2 Missions →</a>
                  </div>
              </div>
  
              <!-- Badge 3: Guardian -->
              <div class="badge-sample-card" style="border-top: 5px solid #ef476f;">
                  <div>
                      <div class="badge-image-container">
                          <img src="/assets/images/badges/guardian.png" alt="Guardian Badge Sample">
                      </div>
                      <div style="text-align: center; margin-bottom: 16px;">
                          <span class="badge-tier-tag" style="background: rgba(239, 71, 111, 0.15); color: #ef476f;">Tier 3 · Community Leadership</span>
                          <h3 style="font-size: 1.5rem; margin: 6px 0 4px 0;">Guardian</h3>
                          <div style="color: #ef476f; font-weight: 600; font-size: 0.95rem;">ডিজিটাল অভিভাবক ও লিডার</div>
                      </div>
                      
                      <p style="color: var(--ink-mid); font-size: 0.92rem; line-height: 1.5; margin-bottom: 16px;">
                          The premier honor for student ambassadors who advocate for digital ethics, guide peers against scams, and foster independent thinking across Bangladesh.
                      </p>
  
                      <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--ink); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Earning Criteria:</h4>
                      <ul class="criteria-list">
                          <li style="color: var(--ink);">Must have earned both <strong>Informed</strong> and <strong>Aware</strong> badges.</li>
                          <li>Complete all <strong>4 Level 2 Missions</strong> with exemplary performance.</li>
                          <li>Lead an awareness discussion or share an Onnoy workbook in your school, college, or community group.</li>
                          <li>Direct approval and verification by Onnoy Founders and Academic Council.</li>
                      </ul>
                  </div>
  
                  <div>
                      <a href="/profile" class="btn" style="background: #ef476f; color: #FFF; width: 100%; text-align: center; display: block;">Check Profile & Eligibility →</a>
                  </div>
              </div>
  
          </div>
  
          <!-- Credential Verification Info Card -->
          <div class="card" style="margin-top: 50px; background: linear-gradient(135deg, rgba(236, 253, 245, 0.6) 0%, rgba(224, 242, 254, 0.6) 100%); border: 1.5px solid var(--border); padding: 36px 32px; border-radius: var(--radius-lg);">
              <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
                  <div style="width: 56px; height: 56px; border-radius: 14px; background: var(--green); display: flex; align-items: center; justify-content: center; color: #FFF; font-size: 1.8rem; flex-shrink: 0;">
                      🛡️
                  </div>
                  <div style="flex: 1; min-width: 260px;">
                      <h3 style="font-size: 1.35rem; margin-bottom: 6px;">How Credential Verification Works</h3>
                      <p style="color: var(--ink-mid); font-size: 0.95rem; line-height: 1.55; margin: 0;">
                          Every badge earned is permanently stamped with your unique student identifier (e.g., <code style="background: var(--surface); padding: 2px 6px; border-radius: 4px; font-weight: 700; color: var(--green);">ONNOY-748291</code>). Teachers, employers, and admission panels can verify your achievements directly via Onnoy's public verification portal.
                      </p>
                  </div>
                  <div>
                      <a href="/profile" class="btn btn-green">View My Profile & Badges →</a>
                  </div>
              </div>
          </div>

          <!-- Public verifier -->
          <div class="card card--flat" id="verify" style="margin-top: 24px;">
              <h3 style="margin-bottom: 6px;">Verify a Student's Badges</h3>
              <p style="color: var(--ink-mid); font-size: 0.95rem;">Enter an Onnoy ID to confirm which credentials a student has earned. No personal contact details are shown.</p>
              <form id="verifyForm" class="cluster" style="margin-top: 8px;" novalidate>
                  <label for="verifyId" class="sr-only">Onnoy ID</label>
                  <input id="verifyId" class="form-control" style="max-width: 280px;" placeholder="ONNOY-123456" pattern="ONNOY-\d{6}" required autocomplete="off" />
                  <button type="submit" class="btn btn-green">Verify</button>
              </form>
              <div id="verifyResult" class="alert hidden" style="margin-top: 16px;" role="status" aria-live="polite"></div>
          </div>

      </section>

  <Fragment slot="scripts">
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('verifyForm');
        const input = document.getElementById('verifyId');
        const out = document.getElementById('verifyResult');
        const labels = { informed: 'Informed', aware: 'Aware', guardian: 'Guardian' };
        const show = (cls, html) => { out.className = 'alert ' + cls; out.innerHTML = html; };
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const id = input.value.trim().toUpperCase();
          if (!/^ONNOY-\d{6}$/.test(id)) { show('alert--warning', 'Please enter an ID in the format <b>ONNOY-123456</b>.'); return; }
          if (!window.supabaseClient) { show('alert--danger', 'Verification service is unavailable right now.'); return; }
          show('', 'Checking…');
          const { data, error } = await window.supabaseClient.rpc('verify_badge', { p_unique_id: id });
          if (error) { show('alert--danger', 'Verification failed. Please try again later.'); return; }
          const row = Array.isArray(data) ? data[0] : data;
          if (!row) { show('alert--warning', `No student found with ID <b>${id}</b>.`); return; }
          const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
          const badges = (row.badges || []).map((b) => `<span class="badge" style="margin:0">${labels[b] || esc(b)}</span>`).join(' ');
          show('alert--success', `<div><b>${esc(row.unique_id)}</b>${row.full_name ? ' · ' + esc(row.full_name) : ''}${row.school_name ? ' · ' + esc(row.school_name) : ''}<br>${badges || '<em>No badges earned yet.</em>'}</div>`);
        });
      });
    </script>
  </Fragment>

</BaseLayout>
