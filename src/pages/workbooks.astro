---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import PublicationAccess from '@components/PublicationAccess.astro';
import PublicationCard from '@components/PublicationCard.astro';
import { getPublications } from '@lib/publications';
import '@/styles/pages/workbooks-inline.css';

const publications = await getPublications();
---

<BaseLayout title="Workbooks & Booklets" description="Official Onnoy decision-making workbooks, guidebooks, and illustrated story booklets for Bangladeshi students, parents, and educators." wrapMain>
  <PageHero title="Workbooks & Booklets" subtitle="ওয়ার্কবুক ও বুকলেট" mainTarget={false}>
    <p>Practical decision-making workbooks, student guidebooks, and illustrated story booklets designed for Bangladeshi youth, parents, and educators. Read directly or unlock your download below.</p>
  </PageHero>

  <section class="section-gap container">
    <div class="workbooks-intro">
      <div class="section-label">Decision Tools For Bangladesh</div>
      <h2 class="section-title">Published Workbooks & Materials</h2>
      <p>Most students and families face high-stakes choices with plenty of noise, but few structured frameworks. Read online, or download your PDF copy instantly.</p>
    </div>

    <aside class="chabondhu-card workbooks-support" aria-labelledby="workbooks-support-title">
      <div class="workbooks-support-copy">
        <h3 id="workbooks-support-title">Sponsor a Student's Booklet</h3>
        <p>Use ChaBondhu for quick small support, or choose any amount through bKash or Nagad on our support page. Every contribution is optional.</p>
      </div>
      <div class="workbooks-support-action">
        <a href="/donate" class="btn-chabondhu">See Support Options →</a>
      </div>
    </aside>

    <div class="workbook-grid">
      {publications.map((publication) => <PublicationCard publication={publication} />)}
    </div>

    <aside class="institution-callout" aria-labelledby="institution-callout-title">
      <div class="institution-callout__icon" aria-hidden="true">🏫</div>
      <div class="institution-callout__copy">
        <h3 id="institution-callout-title">Want Printed Booklets for Your School or College?</h3>
        <p>We partner with high schools, colleges, and youth organizations across Bangladesh to deliver interactive workshops accompanied by physical printed booklets and workbooks for students.</p>
        <div class="institution-callout__links">
          <a href="/assets/docs/Onnoy_Institution_Proposal.pdf" target="_blank">Institutional Reachout Proposal ↗</a>
          <a href="/assets/docs/Onnoy_Sustainability_Plan.pdf" target="_blank">Sustainability & Social Enterprise Plan ↗</a>
        </div>
      </div>
      <a href="/session-request" class="btn btn-green">Invite Onnoy to Your Campus →</a>
    </aside>
  </section>

  <PublicationAccess publications={publications} />
</BaseLayout>