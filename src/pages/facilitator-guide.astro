---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/facilitator-guide.css';
---

<BaseLayout title="Facilitator Guide" description="Onnoy facilitator guide for teachers and youth leaders delivering workshops on digital responsibility and academic honesty.">
  <!-- 2. Hero Section -->
      <header class="hero" id="main" tabindex="-1">
          <div class="container fade-in">
              <h1>Facilitator Guide</h1>
              <p data-i18n="facilitator-subtitle" class="bn-only">সেশন পরিচালনার গাইড</p>
              <p>Everything a teacher or youth worker needs to run an Onnoy session.</p>
          </div>
      </header>
  
      <!-- 3. Main Content -->
      <section class="section-gap container-guide">
          <div class="intro-box">
              <p>This guide is free to download and use. If you run an Onnoy session at your college using this guide, we'd love to hear about it — <a href="https://wa.me/8801830900746" target="_blank" rel="noopener" class="intro-link">reach out to us on WhatsApp</a>.</p>
          </div>
  
          <h2 style="font-size: 1.3rem; color: var(--green); margin-bottom: 20px; text-align: center;">What's Inside</h2>
          
          <div class="features-grid">
              <div class="feature-card">
                  <div class="feature-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  </div>
                  <div class="feature-title">Full Session Plan</div>
                  <div class="feature-description">Minute-by-minute 90-minute session breakdown</div>
              </div>
              <div class="feature-card">
                  <div class="feature-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                  </div>
                  <div class="feature-title">All Three Module Scripts</div>
                  <div class="feature-description">Word-for-word facilitator notes for each module</div>
              </div>
              <div class="feature-card">
                  <div class="feature-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  </div>
                  <div class="feature-title">Discussion Questions</div>
                  <div class="feature-description">Tested questions that actually spark conversation</div>
              </div>
              <div class="feature-card">
                  <div class="feature-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  </div>
                  <div class="feature-title">Student Activity Cards</div>
                  <div class="feature-description">Printable scenario cards for the group activity</div>
              </div>
          </div>
  
          <div class="download-box">
              <div class="download-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              </div>
              <div class="download-title">Onnoy Facilitator Guide — Version 1.0</div>
              <div class="download-subtitle">PDF · Free · Bengali & English</div>
              <div class="coming-soon-badge">PDF Guide — Coming Soon</div>
              <p>The facilitator guide is being prepared. Enter your email below to get notified the moment it's ready.</p>
              
              <form action="https://formspree.io/f/xaqvvobg" method="POST" class="email-form">
                  <input type="hidden" name="_subject" value="Onnoy Facilitator Guide — Notify Me">
                  <input type="email" name="email" class="email-input" placeholder="Your email address" required>
                  <button type="submit" class="notify-btn">Notify Me</button>
              </form>
              
              <div class="attribution">
                  This guide is free to use, adapt, and share with attribution to Onnoy (অন্বয়), Mymensingh, Bangladesh.
              </div>
          </div>
      </section>

</BaseLayout>
