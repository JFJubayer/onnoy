---
import BaseLayout from '@layouts/BaseLayout.astro';

---

<BaseLayout title="Register" description="Register to join Onnoy (অন্বয়) and become a responsible digital citizen." noindex>
  <!-- 1. Page Hero -->
      <header class="hero" id="main" tabindex="-1">
          <div class="container fade-in">
              <h1 data-i18n="auth-register-title">Join Onnoy</h1>
              <p data-i18n="auth-register-subtitle">Start your digital journey</p>
          </div>
      </header>
  
      <div class="container section-gap">
          <div class="card" style="max-width: 480px; margin: 0 auto; padding: 40px; border-radius: var(--radius-lg); box-shadow: var(--shadow);">
              
              <div id="registerCardContent">
                  <div id="authAlert" class="note-box" style="display: none; margin-top: 0; margin-bottom: 20px; padding: 15px;"></div>
  
                  <form id="registerForm">
                      <div class="form-group">
                          <label data-i18n="auth-email">Email Address *</label>
                          <input type="email" id="email" class="form-control" required placeholder="your@email.com" style="margin-top: 8px;">
                      </div>
                      <div class="form-group" style="margin-bottom: 30px;">
                          <label data-i18n="auth-password">Password *</label>
                          <div style="position: relative; margin-top: 8px; display: flex; align-items: center;">
                              <input type="password" id="password" class="form-control" required placeholder="••••••••" style="padding-right: 50px;">
                              <button type="button" id="togglePassword" style="position: absolute; right: 14px; background: none; border: none; cursor: pointer; color: var(--ink-light); display: flex; align-items: center; justify-content: center; padding: 0; flex-shrink: 0;" aria-label="Toggle password visibility">
                                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                              </button>
                          </div>
                      </div>
                      <button type="submit" id="submitBtn" class="btn btn-green full-width" data-i18n="auth-submit-register">Register</button>
                  </form>
  
                  <div style="margin-top: 25px; text-align: center; font-size: 0.95rem; color: var(--ink-mid);">
                      <span data-i18n="auth-have-account">Already have an account?</span> 
                      <a href="/login" style="color: var(--green); font-weight: 600; text-decoration: underline;" data-i18n="nav-login">Log In</a>
                  </div>
              </div>
          </div>
      </div>

  <Fragment slot="scripts">
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('registerForm');
            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            const alertBox = document.getElementById('authAlert');
            const submitBtn = document.getElementById('submitBtn');
            const togglePassword = document.getElementById('togglePassword');
            const registerCardContent = document.getElementById('registerCardContent');

            // Handle password reveal
            togglePassword.addEventListener('click', () => {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                togglePassword.querySelector('svg').innerHTML = type === 'password' 
                    ? '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>' 
                    : '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            });

            // Redirect if already logged in
            const checkSession = async () => {
                if (window.supabaseClient) {
                    const sessionRes = await window.supabaseClient.auth.getSession().catch(() => null);
                    if (sessionRes && sessionRes.data.session) {
                        window.location.href = '/';
                    }
                } else {
                    setTimeout(checkSession, 100);
                }
            };
            checkSession();

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                alertBox.style.display = 'none';
                
                if (!window.supabaseClient) {
                    alertBox.textContent = "Supabase client is not initialized yet. Please check credentials.";
                    alertBox.style.backgroundColor = 'var(--danger-bg)';
                    alertBox.style.color = 'var(--danger-fg)';
                    alertBox.style.borderColor = 'var(--danger-fg)';
                    alertBox.style.display = 'block';
                    return;
                }

                const lang = document.documentElement.getAttribute('lang') || 'en';
                submitBtn.disabled = true;
                submitBtn.textContent = lang === 'bn' ? 'নিবন্ধন হচ্ছে...' : 'Registering...';

                const email = emailInput.value.trim();
                const password = passwordInput.value;

                try {
                    const redirectUrl = window.location.origin + '/login';
                    const { data, error } = await window.supabaseClient.auth.signUp({
                        email: email,
                        password: password,
                        options: {
                            emailRedirectTo: redirectUrl
                        }
                    });

                    if (error) {
                        alertBox.textContent = error.message;
                        alertBox.style.backgroundColor = 'var(--danger-bg)';
                        alertBox.style.color = 'var(--danger-fg)';
                        alertBox.style.borderColor = 'var(--danger-fg)';
                        alertBox.style.display = 'block';
                        submitBtn.disabled = false;
                        submitBtn.textContent = lang === 'bn' ? 'নিবন্ধন করুন' : 'Register';
                    } else {
                        // Registration success
                        registerCardContent.innerHTML = `
                            <div style="text-align: center; padding: 20px 0;">
                                <div style="width: 60px; height: 60px; border-radius: 50%; background-color: var(--success-bg); color: var(--success-fg); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 24px;">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                </div>
                                <h3 style="margin-bottom: 12px; font-family: 'Plus Jakarta Sans', sans-serif;">${lang === 'bn' ? 'নিবন্ধন সম্পন্ন হয়েছে!' : 'Registration Completed!'}</h3>
                                <p style="color: var(--ink-mid); margin-bottom: 25px; font-size: 0.95rem; line-height: 1.6;">
                                    ${lang === 'bn' ? 'আপনার অ্যাকাউন্ট নিবন্ধন সম্পন্ন হয়েছে। অনুগ্রহ করে আপনার অ্যাকাউন্ট অ্যাক্সেস করতে লগইন করুন।' : 'Your account registration is complete. Please log in to access your account.'}
                                </p>
                                <a href="/login" class="btn btn-green" style="display: inline-block;">${lang === 'bn' ? 'লগইন পৃষ্ঠায় যান' : 'Go to Login'}</a>
                            </div>
                        `;
                    }
                } catch (err) {
                    console.error("Register Exception:", err);
                    alertBox.textContent = err.message || "An unexpected error occurred.";
                    alertBox.style.backgroundColor = 'var(--danger-bg)';
                    alertBox.style.color = 'var(--danger-fg)';
                    alertBox.style.borderColor = 'var(--danger-fg)';
                    alertBox.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.textContent = lang === 'bn' ? 'নিবন্ধন করুন' : 'Register';
                }
            });
        });
    </script>
  </Fragment>
</BaseLayout>
