---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/faq.css';
---

<BaseLayout title="FAQ" description="Frequently asked questions about Onnoy's free sessions for students, schools, and partners in Bangladesh.">
  <header class="faq-hero" id="main" tabindex="-1">
          <div class="container">
              <div class="faq-hero-grid">
                  <div class="faq-hero-copy">
                      <span class="section-label">Help Center</span>
                      <h1 data-i18n="faq-title">Frequently Asked Questions</h1>
                      <p class="faq-hero-text" data-i18n="faq-p">Find answers fast with our searchable Help Center designed for students, schools, and partners.</p>
                  </div>
                  <div class="faq-hero-visual" aria-hidden="true">
                      <img src="/assets/images/faq-hero.png" alt="FAQ help center illustration" class="faq-hero-image">
                  </div>
              </div>
          </div>
      </header>
  
      <main class="container">
          <section class="faq-section">
              <div class="faq-container-grid">
                  <aside class="faq-sidebar" aria-label="Help Center navigation">
                      <h3>Jump to section</h3>
                      <ul>
                          <li><a href="#schools" class="faq-nav-link">For Schools & Teachers</a></li>
                          <li><a href="#students" class="faq-nav-link">For Students</a></li>
                          <li><a href="#partners" class="faq-nav-link">For Partners & Sponsors</a></li>
                      </ul>
                      <p class="sidebar-note">Jump directly to the section you need, or expand any question for a quick answer.</p>
                  </aside>
  
                  <div class="faq-content">
                      <article class="faq-category" id="schools">
                          <h2>For Schools & Teachers</h2>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>Is the Onnoy session really free?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Yes — completely free. Always. We never charge schools, students, or teachers. Our sessions are funded through our own initiative and we intend to keep them free for all colleges in Bangladesh.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>How do we invite Onnoy to our college?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Simply fill out the Session Request Form on our website. We will confirm within 48 hours and coordinate the date and logistics with you directly.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>How long is the session?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>90 minutes. We cover three topics — Responsible Use of Technology (20 min), Digital Responsibility (25 min), and Academic Honesty (20 min) — with discussions and activities in between.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>What grade level is this designed for?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Grade 11 and 12 (HSC level). The content and language are specifically designed for this age group.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>Do you need any equipment?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Ideally a projector or screen and a quiet space. But we can adapt to any classroom setup.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>Can you do the session in Bangla?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Yes. All our sessions are conducted in Bangla. The website is bilingual but the live session is fully in Bangla.</p>
                              </div>
                          </div>
                      </article>
  
                      <article class="faq-category" id="students">
                          <h2>For Students</h2>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>Is the quiz and checklist really free?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Yes — everything on this website is free. No login, no signup, no cost.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>Will my support request be kept private?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Absolutely. Everything submitted through the support form is read only by Onnoy team members and never shared with anyone — including your school.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>I submitted something to the fact-check form. How long will it take?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>We aim to respond within 24 hours. During busy periods it may take up to 48 hours.</p>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>Can I share the modules with my friends?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>Please do. Everything on this site is free to read and share.</p>
                              </div>
                          </div>
                      </article>
  
                      <article class="faq-category" id="partners">
                          <h2>For Partners & Sponsors</h2>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>How can we support Onnoy?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>There are two primary ways to support our mission:</p>
                                  <ul style="margin: 8px 0 14px 20px; line-height: 1.6;">
                                      <li><strong>Individual Micro-Donations (ChaBondhu):</strong> You can treat our volunteer team to a cup of tea on our <a href="https://www.chabondhu.com/onnoy" target="_blank" rel="noopener" style="color: #D97706; font-weight: 700; text-decoration: underline;">ChaBondhu page (chabondhu.com/onnoy) ↗</a>. Every ৳5 directly sponsors a printed decision workbook for a student.</li>
                                      <li><strong>Institutional Partnerships & Grants:</strong> If your school, university, foundation, or organization would like to co-host workshops or sponsor regional outreach, please reach out via <a href="https://wa.me/8801830900746" target="_blank" rel="noopener" style="color: var(--green); font-weight: 600; text-decoration: underline;">WhatsApp</a> or submit a <a href="/session-request" style="color: var(--green); font-weight: 600; text-decoration: underline;">Session Request</a>.</li>
                                  </ul>
                              </div>
                          </div>
                          <div class="faq-item">
                              <button class="faq-question" type="button">
                                  <span>Is Onnoy a registered NGO?</span>
                                  <span class="icon">+</span>
                              </button>
                              <div class="faq-answer">
                                  <p>We are a youth-led initiative currently operating in Mymensingh. We are in the process of formal registration. Contact us for more details.</p>
                              </div>
                          </div>
                      </article>
  
                      <div class="help-card">
                          <div class="help-card-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--green);"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div>
                          <div class="help-card-content">
                              <h3>Need more help?</h3>
                              <p>Our team is ready to answer your questions directly. Reach out if you need support beyond the Help Center.</p>
                              <a href="https://wa.me/8801830900746" target="_blank" rel="noopener">Chat with us on WhatsApp</a>
                          </div>
                      </div>
                  </div>
              </div>
          </section>
      </main>

  <Fragment slot="scripts">
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
            const faqItems = Array.from(document.querySelectorAll('.faq-item'));
            const navLinks = Array.from(document.querySelectorAll('.faq-nav-link'));
            let currentOpen = null;

            const closeItem = (item) => {
                const button = item.querySelector('.faq-question');
                const answer = item.querySelector('.faq-answer');
                button.classList.remove('active');
                button.setAttribute('aria-expanded', 'false');
                answer.classList.remove('open');
                answer.style.maxHeight = '0';
                button.querySelector('.icon').textContent = '+';
                if (currentOpen === item) {
                    currentOpen = null;
                }
            };

            const openItem = (item) => {
                const button = item.querySelector('.faq-question');
                const answer = item.querySelector('.faq-answer');
                button.classList.add('active');
                button.setAttribute('aria-expanded', 'true');
                answer.classList.add('open');
                answer.style.maxHeight = answer.scrollHeight + 'px';
                button.querySelector('.icon').textContent = '−';
                currentOpen = item;
            };

            const resetAnswers = () => {
                faqItems.forEach(item => {
                    const answer = item.querySelector('.faq-answer');
                    answer.style.maxHeight = item.querySelector('.faq-question').classList.contains('active') ? answer.scrollHeight + 'px' : '0';
                });
            };

            faqItems.forEach((item, i) => {
                const button = item.querySelector('.faq-question');
                const answer = item.querySelector('.faq-answer');
                if (!answer.id) answer.id = 'faq-answer-' + (i + 1);
                button.setAttribute('aria-controls', answer.id);
                button.setAttribute('aria-expanded', 'false');
                answer.style.maxHeight = '0';
                button.addEventListener('click', () => {
                    if (item === currentOpen) {
                        closeItem(item);
                        return;
                    }
                    if (currentOpen) {
                        closeItem(currentOpen);
                    }
                    openItem(item);
                });
            });

            navLinks.forEach(link => {
                link.addEventListener('click', (event) => {
                    event.preventDefault();
                    navLinks.forEach(item => item.classList.remove('active'));
                    link.classList.add('active');
                    const targetId = link.getAttribute('href').substring(1);
                    const target = document.getElementById(targetId);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            window.addEventListener('resize', resetAnswers);
        });
    </script>
  </Fragment>
</BaseLayout>
