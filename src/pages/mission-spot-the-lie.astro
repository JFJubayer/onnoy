---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import MissionFallback from '@components/MissionFallback.astro';
import { missionFallbacks } from '@data/mission-fallbacks';
import '@/styles/pages/module-course.css';

const mission = missionFallbacks.spotLie;
---

<BaseLayout title="Mission 1: Spot the Lie" description="Mission 1: Spot the Lie, a Level 2 Onnoy mission.">
  <PageHero title={mission.title} subtitle={`Mission ${mission.number}`} class="module-hero" />
  <main class="container section-gap" data-mission="spotLie"><MissionFallback mission={mission} /></main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/module-course.js"></script>
  </Fragment>
</BaseLayout>
