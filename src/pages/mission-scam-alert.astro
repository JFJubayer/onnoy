---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/module-course.css';
---

<BaseLayout title="Mission 2: Scam Alert" description="Mission 2: Scam Alert, a Level 2 Onnoy mission.">
  <header class="hero module-hero" id="main" tabindex="-1"><div class="container fade-in"><h1>Scam Alert</h1><p>Mission 2</p></div></header>
      <main class="container section-gap" data-mission="scamAlert"></main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/module-course.js"></script>
  </Fragment>
</BaseLayout>
