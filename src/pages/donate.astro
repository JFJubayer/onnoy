---
import BaseLayout from '@layouts/BaseLayout.astro';
import PublicationAccess from '@components/PublicationAccess.astro';
import { Copy } from '@lucide/astro';
import { SITE } from '@data/site';
import { translations } from '@data/translations';
import { getPublications, publicationAccessUrl } from '@lib/publications';
import QRCode from 'qrcode';
import '@/styles/pages/donate.css';

const publications = await getPublications();
const qrCode = await QRCode.toDataURL(SITE.chabondhu, {
  errorCorrectionLevel: 'H',
  margin: 4,
  width: 600,
  color: { dark: '#171717', light: '#ffffff' },
});
---

<BaseLayout title="Support Onnoy" description="Support Onnoy's youth-led workbooks, booklets, and learning sessions through ChaBondhu. Every contribution is voluntary." bodyClass="donation-body" minimal>
  <main id="main" class="donation-page" tabindex="-1">
    <div class="container donation-grid">
      <section class="donation-note" aria-labelledby="donation-title">
        <a href="/workbooks" class="donation-back" data-i18n="donation-back">Back to workbooks</a>
        <div class="donation-onima-intro">
          <img src="/assets/images/guide/onima-open.webp" width="112" height="112" alt="Onima waving" />
          <div>
            <p class="donation-eyebrow" data-i18n="donation-eyebrow">A note from Onima</p>
            <h1 id="donation-title" data-i18n="donation-title">Help another voice be heard</h1>
          </div>
        </div>
        <p class="donation-lead" data-i18n="donation-lead">A young person shouldn't have to figure everything out alone.</p>
        <p class="donation-story" data-i18n="donation-story">A subject to choose. A future that feels uncertain. A conversation at home that is hard to begin. We make these resources for those moments, when a little guidance can mean a lot.</p>
        <p class="donation-story" data-i18n="donation-invite">If these pages have been useful to you, help us create the next ones. Your contribution supports the time, care, and work behind Onnoy's booklets and learning sessions.</p>
        <div class="donation-actions">
          <a id="donation-link" href={SITE.chabondhu} target="_blank" rel="noopener noreferrer" class="btn btn-green btn-lg" data-donation-option="chabondhu" data-i18n="donation-button">Quick support on ChaBondhu</a>
          <p class="donation-optional" data-i18n="donation-optional">Give what feels right. A donation is not required to download this PDF.</p>
        </div>
        <section id="direct-donation" class="donation-direct" aria-labelledby="direct-donation-title">
          <p class="donation-direct-eyebrow" data-i18n="donation-direct-eyebrow">Want to give a different amount?</p>
          <h2 id="direct-donation-title" data-i18n="donation-direct-title">Send any amount with bKash or Nagad</h2>
          <p class="donation-direct-description" data-i18n="donation-direct-description">Use Send Money in your own app. This is a manual transfer; this website does not process or verify it.</p>
          <div class="donation-amount-control">
            <label for="directDonationAmount" data-i18n="donation-amount-label">Amount you plan to send</label>
            <div class="donation-amount-input">
              <span aria-hidden="true">৳</span>
              <input id="directDonationAmount" type="number" min="1" step="1" value="500" inputmode="numeric" />
            </div>
            <div class="donation-presets" role="group" aria-label="Suggested donation amounts">
              {[100, 500, 1000, 2500].map((amount) => <button type="button" data-donation-amount={amount} aria-pressed={amount === 500 ? 'true' : 'false'}>৳{amount}</button>)}
            </div>
            <button type="button" class="donation-copy-amount" data-donation-copy="amount"><Copy size={16} /><span data-i18n="donation-copy-amount">Copy amount</span></button>
          </div>
          <div class="donation-methods">
            {['bKash', 'Nagad'].map((method) => (
              <div class:list={['donation-method', `donation-method--${method.toLowerCase()}`]}>
                <div class="donation-method-name"><strong>{method}</strong><span data-i18n="donation-personal-account">Personal · Send Money</span></div>
                <code>{SITE.donationNumber}</code>
                <button type="button" data-donation-copy="number" data-copy-value={SITE.donationNumber} aria-label={`Copy ${method} number`}><Copy size={16} /><span data-i18n="donation-copy-number">Copy number</span></button>
              </div>
            ))}
          </div>
          <p class="donation-direct-steps" data-i18n="donation-direct-steps">Open your app → Send Money → enter the number → enter your amount → review and confirm.</p>
          <p class="donation-direct-safety" data-i18n="donation-direct-safety">Never share your PIN, OTP, or app password with Onnoy or anyone else.</p>
          <p id="directDonationStatus" class="donation-direct-status" role="status" aria-live="polite"></p>
        </section>
        <div class="donation-signature">
          <p data-i18n="donation-gratitude">With gratitude,</p>
          <strong data-i18n="donation-team">The Onnoy volunteers</strong>
          <span data-i18n="footer-location">Mymensingh, Bangladesh</span>
        </div>
      </section>

      <aside class="donation-reading" aria-label="Download and donation options">
        <section id="donation-download" class="donation-download" aria-labelledby="download-heading" hidden>
          <h2 id="download-heading" data-i18n="donation-ready">Your PDF is ready</h2>
          {publications.map((publication) => (
            <article class="donation-publication" data-publication={publication.pdf} hidden>
              <div class="donation-publication-details">
                <img src={publication.cover} alt={publication.title} width="86" height="122" class="donation-cover" />
                <div>
                  <span class="donation-file-type">PDF / Onnoy</span>
                  <h3>{publication.title}</h3>
                  <p lang="bn">{publication.titleBn}</p>
                </div>
              </div>
              <a href={publicationAccessUrl(publication.pdf, 'download')} data-reader-resource={publication.pdf} data-reader-action="download" class="btn btn-secondary donation-download-button" data-download data-i18n="donation-download">Download PDF</a>
              <a href={publicationAccessUrl(publication.pdf, 'read')} data-reader-resource={publication.pdf} data-reader-action="read" class="donation-read-link" data-i18n="donation-read">Read online</a>
            </article>
          ))}
          <p id="donation-download-status" class="donation-download-status" role="status" aria-live="polite" data-i18n="donation-download-status" hidden>Download requested. Thank you for reading.</p>
        </section>

        <div id="donation-library" class="donation-library">
          <div class="donation-book-row">
            {publications.map((publication) => (
              <a href="/workbooks" title={publication.title}>
                <img src={publication.cover} alt={publication.title} width="100" height="142" />
              </a>
            ))}
          </div>
          <a href="/workbooks" class="donation-read-link" data-i18n="donation-library">Explore the workbooks & booklets</a>
        </div>

        <div class="donation-qr">
          <a href={SITE.chabondhu} target="_blank" rel="noopener noreferrer" aria-label="Support Onnoy on ChaBondhu" data-donation-option="chabondhu">
            <img id="donation-qr" src={qrCode} width="152" height="152" alt="QR code for Onnoy's ChaBondhu donation page" />
          </a>
          <div>
            <h2 data-i18n="donation-qr-heading">A small gesture.<br />A shared future.</h2>
            <a href={SITE.chabondhu} target="_blank" rel="noopener noreferrer" class="donation-url" data-donation-option="chabondhu">chabondhu.com/onnoy</a>
            <p data-i18n="donation-payment">Contributions are handled on ChaBondhu.</p>
          </div>
        </div>

        <noscript>
          <section class="donation-download">
            <h2>{translations['donation-ready'].en}</h2>
            <ul class="donation-fallback-links">
              {publications.map((publication) => (
                <li><a href={publicationAccessUrl(publication.pdf, 'download')}>{publication.title}</a></li>
              ))}
            </ul>
          </section>
        </noscript>
      </aside>
    </div>

    <section class="donation-purpose" aria-labelledby="purpose-heading">
      <div class="container">
        <h2 id="purpose-heading" data-i18n="donation-purpose">What your support makes possible</h2>
        <div class="donation-purpose-grid">
          <div>
            <span class="donation-purpose-number" aria-hidden="true">01</span>
            <h3 data-i18n="donation-purpose-resources">Better learning resources</h3>
            <p data-i18n="donation-purpose-resources-text">Time to write, illustrate, and improve thoughtful guidance for students and families.</p>
          </div>
          <div>
            <span class="donation-purpose-number" aria-hidden="true">02</span>
            <h3 data-i18n="donation-purpose-sessions">More meaningful conversations</h3>
            <p data-i18n="donation-purpose-sessions-text">Materials and preparation for learning sessions with schools and communities.</p>
          </div>
          <div>
            <span class="donation-purpose-number" aria-hidden="true">03</span>
            <h3 data-i18n="donation-purpose-volunteers">An independent youth initiative</h3>
            <p data-i18n="donation-purpose-volunteers-text">Practical support for the volunteers who keep this work moving.</p>
          </div>
        </div>
        <p class="donation-thanks" data-i18n="donation-thanks">Whether you give, share something helpful, or simply use these pages well: thank you for being part of Onnoy.</p>
      </div>
    </section>
  </main>

  <section class="donation-print" aria-label="Publication closing page">
    <div class="donation-print-brand">
      <img src="/assets/images/logo-v2.jpeg" alt="Onnoy" width="40" height="40" />
      <p>Onnoy - অন্বয়<br /><span>Mymensingh, Bangladesh</span></p>
    </div>
    <h2>{translations['donation-print-heading'].en}</h2>
    <p class="donation-print-heading-bn" lang="bn">{translations['donation-print-heading'].bn}</p>
    <p class="donation-print-body">{translations['donation-print-body'].en}</p>
    <p class="donation-print-body" lang="bn">{translations['donation-print-body'].bn}</p>
    <a class="donation-print-link" href={SITE.chabondhu}>
      <img id="donation-print-qr" src={qrCode} width="144" height="144" alt="Donate to Onnoy on ChaBondhu" />
    </a>
    <a class="donation-print-url" href={SITE.chabondhu}>www.chabondhu.com/onnoy</a>
    <p class="donation-print-thanks">{translations['donation-print-thanks'].en}<br /><span lang="bn">{translations['donation-print-thanks'].bn}</span></p>
  </section>

  <PublicationAccess publications={publications} />
</BaseLayout>

<script>
  const resource = new URLSearchParams(window.location.search).get('resource');
  const selected = Array.from(document.querySelectorAll<HTMLElement>('[data-publication]'))
    .find((publication) => publication.dataset.publication === resource);
  const downloadSection = document.getElementById('donation-download');
  const library = document.getElementById('donation-library');
  const downloadStatus = document.getElementById('donation-download-status');

  if (selected && downloadSection && library) {
    selected.hidden = false;
    downloadSection.hidden = false;
    library.hidden = true;
  }

  document.addEventListener('publication:download', () => {
    if (downloadStatus) downloadStatus.hidden = false;
  });
</script>

<script>
  import '@scripts/direct-donation';
</script>