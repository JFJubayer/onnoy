---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ResourceLibraryControls from '@components/ResourceLibraryControls.astro';
import '@/styles/pages/resources-library.css';
---

<BaseLayout title="Resource Library" description="Onnoy's resource library with tools, guides, and links for students learning digital responsibility and ethical technology use." wrapMain>
    <PageHero title="Resource Library" subtitle="সহায়ক তথ্যভান্ডার" mainTarget={false}>
        <p>Trusted tools, websites, and guides curated for Bangladeshi students.</p>
    </PageHero>
  
      <!-- 3. Resources Section -->
      <section class="section-gap container">
          <div class="resource-library-content">
              
              <!-- Section 0: Workbooks & Booklets -->
              <h2 id="workbooks-booklets" class="resource-section-title resource-section-title--primary">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                  Workbooks & Booklets
              </h2>
              <p class="resource-intro">
                  Official Onnoy decision-making workbooks, student guidebooks, and illustrated story booklets. Free for students, parents, and teachers to read and download.
              </p>
              <div class="resource-workbooks-gateway">
                  <div class="resource-workbooks-covers" aria-hidden="true">
                      <img src="/assets/images/covers/cover-onima-complete.png" alt="">
                      <img src="/assets/images/covers/cover-not-sure-study.png" alt="">
                      <img src="/assets/images/covers/cover-cv-guide.png" alt="">
                      <img src="/assets/images/covers/cover-free-ai-guide.png" alt="">
                  </div>
                  <div>
                      <h3>All four Onnoy ebooks, in one place</h3>
                      <p>Compare intended readers and highlights, read online, or request your free PDF copy from the dedicated books page. Support is always optional.</p>
                      <a href="/workbooks" class="btn btn-green">Explore Free Ebooks →</a>
                  </div>
              </div>

              <ResourceLibraryControls />
              
              <!-- Section 1: Fact Checking Sites -->
              <section data-resource-section="fact-check">
              <h2 class="resource-section-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>Fact Checking Sites</h2>
              <div class="resources-grid">
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Boom Live</div>
                              <div class="resource-description">India and Bangladesh focused fact-checking</div>
                          </div>
                          <div class="resource-category">Fact Check</div>
                      </div>
                      <a href="https://boomlive.in" target="_blank" class="resource-link">Visit →</a>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Rumor Scanner</div>
                              <div class="resource-description">Bangladesh's own fact-checking platform</div>
                          </div>
                          <div class="resource-category">Fact Check</div>
                      </div>
                      <a href="https://rumorscanner.com" target="_blank" class="resource-link">Visit →</a>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Snopes</div>
                              <div class="resource-description">One of the world's oldest fact-checking sites</div>
                          </div>
                          <div class="resource-category">Fact Check</div>
                      </div>
                      <a href="https://snopes.com" target="_blank" class="resource-link">Visit →</a>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">AFP Fact Check</div>
                              <div class="resource-description">International fact-checking by AFP news agency</div>
                          </div>
                          <div class="resource-category">Fact Check</div>
                      </div>
                      <a href="https://factcheck.afp.com" target="_blank" class="resource-link">Visit →</a>
                  </div>
              </div>
              </section>
  
              <!-- Section 2: Digital Safety -->
              <section data-resource-section="safety">
              <h2 class="resource-section-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Digital Safety</h2>
              <div class="resources-grid">
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Bangladesh Telecommunication Regulatory Commission</div>
                              <div class="resource-description">Official cybercrime reporting in Bangladesh</div>
                          </div>
                          <div class="resource-category">Safety</div>
                      </div>
                      <a href="https://btrc.gov.bd" target="_blank" class="resource-link">Visit →</a>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Cyber Help Bangladesh</div>
                              <div class="resource-description">Local digital support resource</div>
                          </div>
                          <div class="resource-category">Safety</div>
                      </div>
                      <span class="resource-link resource-link-disabled" aria-disabled="true">Listing pending</span>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Google Safety Center</div>
                              <div class="resource-description">How to protect your Google account and data</div>
                          </div>
                          <div class="resource-category">Safety</div>
                      </div>
                      <a href="https://safety.google" target="_blank" class="resource-link">Visit →</a>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Digital Safety Laws in Bangladesh</div>
                              <div class="resource-description">A guided reference to cyber safety, online harm, AI abuse, copyright, and privacy laws</div>
                          </div>
                          <div class="resource-category">Law</div>
                      </div>
                      <a href="/digital-safety-laws" class="resource-link">Read guide →</a>
                  </div>
              </div>
              </section>
  
              <!-- Section 3: Academic Integrity -->
              <section data-resource-section="academic">
              <h2 class="resource-section-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>Academic Integrity</h2>
              <div class="resources-grid">
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Grammarly Plagiarism Checker</div>
                              <div class="resource-description">Check your writing for unintentional plagiarism</div>
                          </div>
                          <div class="resource-category">Academic</div>
                      </div>
                      <a href="https://grammarly.com" target="_blank" class="resource-link">Visit →</a>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Cite This For Me</div>
                              <div class="resource-description">Free and easy reference generator</div>
                          </div>
                          <div class="resource-category">Academic</div>
                      </div>
                      <a href="https://citethisforme.com" target="_blank" class="resource-link">Visit →</a>
                  </div>
              </div>
              </section>
  
              <!-- Section 4: Screen Time & Digital Wellbeing -->
              <section data-resource-section="wellbeing">
              <h2 class="resource-section-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>Screen Time & Digital Wellbeing</h2>
              <div class="resources-grid">
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Google Digital Wellbeing</div>
                              <div class="resource-description">Tools to understand your phone habits</div>
                          </div>
                          <div class="resource-category">Wellbeing</div>
                      </div>
                      <a href="https://wellbeing.google" target="_blank" class="resource-link">Visit →</a>
                  </div>
                  <div class="resource-card">
                      <div class="resource-header">
                          <div>
                              <div class="resource-name">Common Sense Media</div>
                              <div class="resource-description">Guides for healthy technology use</div>
                          </div>
                          <div class="resource-category">Wellbeing</div>
                      </div>
                      <a href="https://commonsense.org" target="_blank" class="resource-link">Visit →</a>
                  </div>
              </div>
              </section>
  
              <div class="disclaimer">
                  Onnoy does not own or control these external websites. Links are provided for educational purposes only.
              </div>
          </div>
      </section>

</BaseLayout>
