---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/module-course.css';
---

<BaseLayout title="Attention Literacy" description="Attention Literacy lesson from Onnoy's Digital Citizenship course.">
  <header class="hero module-hero" id="main" tabindex="-1"><div class="container fade-in"><h1>Attention Literacy</h1><p>Digital wellbeing and attention</p></div></header>
      <main class="container section-gap" data-lesson="attention"></main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/module-course.js"></script>
  </Fragment>
</BaseLayout>
