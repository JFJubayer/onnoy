---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/session-request.css';
---

<BaseLayout title="Request a Session" description="Invite Onnoy to your college for a free 90-minute session on ethical use of technology for Grade 11-12 students. Based in Mymensingh, Bangladesh.">
  <!-- 2. Split Hero Section -->
      <header class="hero" id="main" tabindex="-1">
          <div class="hero-split fade-in">
              <div class="hero-content">
                  <span class="section-label" data-i18n="session-label">Bring Onnoy to Your Campus</span>
                  <h1 data-i18n="session-title">Invite Onnoy to Your College</h1>
                  <div class="subtitle" data-i18n="session-subtitle">Invite Onnoy to Your Campus</div>
                  <p data-i18n="session-p">We deliver free, high-impact sessions on the ethical use of technology. Join the growing list of colleges empowering their students with digital wisdom.</p>
                  <div class="mini-stat-row">
                      <div class="mini-stat-pill">
                          <strong>90 min</strong> session
                      </div>
                      <div class="mini-stat-pill">
                          <strong>Free</strong> of cost
                      </div>
                  </div>
              </div>
              <div class="hero-image">
                  <img src="/assets/images/youth-tech.png" alt="Students learning together illustration">
              </div>
          </div>
      </header>
  
      <!-- 3. Form Section -->
      <main class="container">
          <div class="form-container-boxed">
              <form action="https://formspree.io/f/xpqbbkgw" method="POST" class="fade-in">
                  <input type="hidden" name="_subject" value="Onnoy Session Request — New College">
                  
                  <!-- Section 1: Primary Contact -->
                  <div class="form-section">
                      <div class="form-section-title">
                          <span></span> Primary Contact
                      </div>
                      <div class="form-grid">
                          <div class="form-group">
                              <label for="name">Full Name *</label>
                              <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Abdullah Al Mamun" required>
                          </div>
                          <div class="form-group">
                              <label for="designation">Designation *</label>
                              <input type="text" id="designation" name="designation" class="form-control" placeholder="e.g. Teacher, Student Rep" required>
                          </div>
                          <div class="form-group">
                              <label for="phone">Phone Number *</label>
                              <input type="text" id="phone" name="phone" class="form-control" placeholder="+880..." required>
                          </div>
                          <div class="form-group">
                              <label for="email">Email Address *</label>
                              <input type="email" id="email" name="email" class="form-control" placeholder="example@college.edu.bd" required>
                          </div>
                      </div>
                  </div>
  
                  <!-- Section 2: Institution Details -->
                  <div class="form-section">
                      <div class="form-section-title">
                          <span></span> Institution Details
                      </div>
                      <div class="form-grid">
                          <div class="form-group form-group-wide">
                              <label for="college">College Name *</label>
                              <input type="text" id="college" name="college" class="form-control" placeholder="Full name of your college" required>
                          </div>
                          <div class="form-group">
                              <label for="district">District *</label>
                              <input type="text" id="district" name="district" class="form-control" placeholder="e.g. Mymensingh" required>
                          </div>
                          <div class="form-group">
                              <label for="students">Approximate Students *</label>
                              <select id="students" name="students" class="form-control" required>
                                  <option value="">Select range...</option>
                                  <option value="Under 30">Under 30</option>
                                  <option value="30–60">30–60</option>
                                  <option value="60–100">60–100</option>
                                  <option value="100–150">100–150</option>
                                  <option value="150+">150+</option>
                              </select>
                          </div>
                      </div>
                  </div>
  
                  <!-- Section 3: Logistics -->
                  <div class="form-section">
                      <div class="form-section-title">
                          <span></span> Session Logistics
                      </div>
                      <div class="form-group">
                          <label for="date">Preferred Date *</label>
                          <input type="date" id="date" name="date" class="form-control" required>
                          <small class="form-note">Note: We usually need at least 1 week lead time.</small>
                      </div>
                      <div class="form-group">
                          <label for="notes">Special Requests or Questions</label>
                          <textarea id="notes" name="notes" class="form-control" rows="4" placeholder="Anything we should know about your setup or students?"></textarea>
                      </div>
                  </div>
  
                  <div class="text-center">
                      <button type="submit" class="btn btn-green full-submit">Submit Session Request →</button>
                      <p class="form-disclaimer">By submitting, you agree to our team contacting you via phone or email.</p>
                  </div>
              </form>
          </div>
      </main>
  
      <!-- 4. Process Timeline -->
      <section class="process-section fade-in">
          <div class="container">
              <span class="section-label text-center">The Journey</span>
              <h2 class="section-title text-center">What Happens Next?</h2>
              <div class="process-steps">
                  <div class="step">
                      <div class="step-num">1</div>
                      <h4>Submit</h4>
                      <p>Fill out the form above with your details.</p>
                  </div>
                  <div class="step">
                      <div class="step-num">2</div>
                      <h4>Review</h4>
                      <p>Our team reviews your request within 48 hours.</p>
                  </div>
                  <div class="step">
                      <div class="step-num">3</div>
                      <h4>Confirm</h4>
                      <p>We call you to finalize the date and time.</p>
                  </div>
                  <div class="step">
                      <div class="step-num">4</div>
                      <h4>Session!</h4>
                      <p>Onnoy arrives at your college for the session.</p>
                  </div>
              </div>
          </div>
      </section>
  
      <!-- 5. Trust Box -->
      <section class="container section-gap fade-in">
          <div class="card highlight-card">
              <div class="card-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--green);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 11 2 2 4-4"></path></svg></div>
              <h3>Safe & Professional</h3>
              <p>Our facilitators are trained to handle sensitive topics with maturity. All sessions are non-political, non-judgmental, and focused entirely on digital safety and ethics.</p>
          </div>
      </section>

</BaseLayout>
