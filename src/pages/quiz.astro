---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@/styles/pages/quiz.css';
---

<BaseLayout title="Digital Safety Quiz" description="Take Onnoy's 10-question Digital Safety Quiz and find out how digitally responsible you really are. Free quiz for Bangladeshi students.">
  <!-- 2. Hero Section -->
      <header class="hero" id="main" tabindex="-1">
          <div class="container fade-in visible">
              <h1> ডিজিটাল নিরাপত্তা কুইজ</h1>
              <p>Digital Safety Quiz</p>
              <p>10 questions. Find out how digitally responsible you really are.</p>
          </div>
      </header>
  
      <!-- 3. Quiz Section -->
      <section class="section-gap container">
          <div class="quiz-container">
              <div class="progress-bar">
                  <div class="progress-fill" id="progress-fill"></div>
              </div>
              <div id="quiz">
                  <div class="question" id="question"></div>
                  <div class="options" id="options"></div>
                  <button class="next-btn" id="next-btn">Next →</button>
              </div>
              <div class="results" id="results">
                  <div class="score" id="score"></div>
                  <div class="message" id="message"></div>
                  
                  <div class="buttons">
                      <button class="btn btn-green" onclick="retakeQuiz()">Retake Quiz</button>
                      <a href="/modules" class="btn btn-green">Explore Modules →</a>
                  </div>
                  <div class="share-text">Tell a friend to take this quiz at onnoy.vercel.app/quiz</div>
              </div>
          </div>
      </section>

  <Fragment slot="scripts">
    <script is:inline>
        const questions = [
            {
                question: "You receive a WhatsApp message saying \"URGENT: Drinking lemon water cures fever — share with everyone!\" What do you do?",
                options: [
                    { text: "Share it immediately, it sounds helpful", score: 0 },
                    { text: "Ignore it and move on", score: 5 },
                    { text: "Search for it on a trusted health website before sharing", score: 10 },
                    { text: "Ask a friend if it's true", score: 5 }
                ]
            },
            {
                question: "A classmate posts an embarrassing photo of you in a group chat as a joke. What is this called?",
                options: [
                    { text: "Just a harmless prank", score: 0 },
                    { text: "Cyberbullying", score: 10 },
                    { text: "Normal group chat behavior", score: 0 },
                    { text: "A misunderstanding", score: 5 }
                ]
            },
            {
                question: "You have an assignment due tomorrow. You find a perfect paragraph on Wikipedia. You:",
                options: [
                    { text: "Copy it word for word", score: 0 },
                    { text: "Change a few words and submit", score: 0 },
                    { text: "Read it, understand it, then write it in your own words", score: 10 },
                    { text: "Copy it but add your name at the bottom", score: 0 }
                ]
            },
            {
                question: "Your screen time report shows 5 hours on social media today. You feel:",
                options: [
                    { text: "Fine — everyone does it", score: 0 },
                    { text: "Curious about what I actually did in those 5 hours", score: 10 },
                    { text: "Proud — I stay connected", score: 0 },
                    { text: "Nothing, I don't check screen time", score: 0 }
                ]
            },
            {
                question: "A friend shares a news headline that seems shocking. You:",
                options: [
                    { text: "Share it — the headline says it all", score: 0 },
                    { text: "Read the full article from a trusted source first", score: 10 },
                    { text: "Like it but don't share", score: 5 },
                    { text: "Argue about it in the comments", score: 0 }
                ]
            },
            {
                question: "Someone you don't know sends you a friend request with very few posts and no mutual friends. You:",
                options: [
                    { text: "Accept — the more friends the better", score: 0 },
                    { text: "Accept if they look nice in their profile photo", score: 0 },
                    { text: "Ignore or decline — suspicious profile", score: 10 },
                    { text: "Accept and give them your phone number", score: 0 }
                ]
            },
            {
                question: "You post something online and regret it an hour later. You delete it. Is it gone?",
                options: [
                    { text: "Yes — deleted means gone", score: 0 },
                    { text: "Not necessarily — others may have screenshotted or shared it", score: 10 },
                    { text: "Yes, if you delete quickly enough", score: 0 },
                    { text: "Only if it had no likes", score: 0 }
                ]
            },
            {
                question: "A rumor about a classmate is spreading in a Facebook group. You know it is false. You:",
                options: [
                    { text: "Stay silent — not my problem", score: 0 },
                    { text: "Share it with a question mark", score: 0 },
                    { text: "Privately tell the classmate and encourage them to report it", score: 10 },
                    { text: "Laugh along with the group", score: 0 }
                ]
            },
            {
                question: "You are studying but keep checking your phone every few minutes. This is:",
                options: [
                    { text: "Normal teenage behavior — nothing wrong", score: 0 },
                    { text: "A sign that the apps are designed to pull your attention", score: 10 },
                    { text: "A sign you are not smart enough to focus", score: 0 },
                    { text: "Only a problem if your grades drop", score: 0 }
                ]
            },
            {
                question: "Giving credit to a source when you use their idea in your work is:",
                options: [
                    { text: "Unnecessary — ideas belong to everyone", score: 0 },
                    { text: "Only needed for published books", score: 0 },
                    { text: "A sign of academic literacy and honesty", score: 10 },
                    { text: "Something only university students do", score: 0 }
                ]
            }
        ];

        let currentQuestion = 0;
        let score = 0;
        let selectedOption = null;

        const questionEl = document.getElementById('question');
        const optionsEl = document.getElementById('options');
        const nextBtn = document.getElementById('next-btn');
        const progressFill = document.getElementById('progress-fill');
        const quizEl = document.getElementById('quiz');
        const resultsEl = document.getElementById('results');
        const scoreEl = document.getElementById('score');
        const messageEl = document.getElementById('message');

        function loadQuestion() {
            const q = questions[currentQuestion];
            questionEl.textContent = q.question;
            optionsEl.innerHTML = '';
            selectedOption = null;
            nextBtn.style.display = 'none';

            q.options.forEach((option, index) => {
                const optionEl = document.createElement('button');
                optionEl.type = 'button';
                optionEl.className = 'option';
                optionEl.textContent = option.text;
                optionEl.setAttribute('aria-pressed', 'false');
                optionEl.onclick = () => selectOption(optionEl, index);
                optionsEl.appendChild(optionEl);
            });

            updateProgress();
        }

        function selectOption(el, index) {
            // Remove selected state from all
            document.querySelectorAll('.option').forEach(opt => {
                opt.classList.remove('selected');
                opt.setAttribute('aria-pressed', 'false');
            });
            // Add to clicked
            el.classList.add('selected');
            el.setAttribute('aria-pressed', 'true');
            selectedOption = index;
            nextBtn.style.display = 'block';
        }

        function nextQuestion() {
            if (selectedOption !== null) {
                score += questions[currentQuestion].options[selectedOption].score;
                currentQuestion++;
                if (currentQuestion < questions.length) {
                    loadQuestion();
                } else {
                    showResults();
                }
            }
        }

        function updateProgress() {
            const progress = ((currentQuestion + 1) / questions.length) * 100;
            progressFill.style.width = progress + '%';
        }

        function showResults() {
            quizEl.style.display = 'none';
            resultsEl.style.display = 'block';

            scoreEl.textContent = `Score: ${score}/100`;

            let message = '';
            if (score >= 90) {
                message = " Digital Champion! — তুমি সত্যিই সচেতন। You clearly think before you click. Share this quiz with a friend!";
            } else if (score >= 60) {
                message = " Pretty Responsible — তুমি ভালোই করছ। You're on the right track but a few blind spots remain. Re-read the modules!";
            } else if (score >= 30) {
                message = " Learning in Progress — আরো জানার আছে। Some of your digital habits need attention. Explore the Onnoy modules!";
            } else {
                message = " Wake Up Call! — একটু ভাবো। This quiz is a sign to take digital responsibility seriously. Start with Module 1!";
            }
            messageEl.textContent = message;
        }


        function retakeQuiz() {
            currentQuestion = 0;
            score = 0;
            selectedOption = null;
            resultsEl.style.display = 'none';
            quizEl.style.display = 'block';
            loadQuestion();
        }

        nextBtn.onclick = nextQuestion;

        // Start quiz
        loadQuestion();
    </script>
  </Fragment>
</BaseLayout>
