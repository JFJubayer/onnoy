---
import BaseLayout from '@layouts/BaseLayout.astro';
import { translations } from '@data/translations';
import '@/styles/pages/quiz.css';
---

<BaseLayout title="Digital Habits Self-Assessment" description="Reflect on ten everyday digital decisions, learn from every choice, and find the Onnoy lesson that can help you next." compactFooter>
  <header class="hero assessment-hero" id="main" tabindex="-1">
    <div class="container fade-in visible">
      <h1 data-i18n="assessment-hero-title">{translations['assessment-hero-title'].en}</h1>
      <p data-i18n="assessment-hero-subtitle">{translations['assessment-hero-subtitle'].en}</p>
    </div>
  </header>

  <main class="section-gap container assessment-page">
    <section id="assessmentShell" class="assessment-shell" aria-labelledby="assessmentMainTitle">
      <div id="assessmentIntro" class="assessment-intro">
        <p class="assessment-eyebrow" data-i18n="assessment-intro-eyebrow">{translations['assessment-intro-eyebrow'].en}</p>
        <h2 id="assessmentMainTitle" data-i18n="assessment-intro-title">{translations['assessment-intro-title'].en}</h2>
        <p class="assessment-intro-body" data-i18n="assessment-intro-body">{translations['assessment-intro-body'].en}</p>
        <ul class="assessment-features">
          <li data-i18n="assessment-feature-feedback">{translations['assessment-feature-feedback'].en}</li>
          <li data-i18n="assessment-feature-domains">{translations['assessment-feature-domains'].en}</li>
          <li data-i18n="assessment-feature-next">{translations['assessment-feature-next'].en}</li>
        </ul>
        <button id="assessmentStart" type="button" class="btn btn-green" data-i18n="assessment-start">{translations['assessment-start'].en}</button>
        <p class="assessment-privacy" data-i18n="assessment-privacy">{translations['assessment-privacy'].en}</p>
      </div>

      <section id="assessmentQuiz" class="assessment-quiz" aria-labelledby="assessmentQuestion" hidden>
        <header class="assessment-question-header">
          <div>
            <p id="assessmentDomain" class="assessment-domain"></p>
            <p id="assessmentCounter" class="assessment-counter"></p>
          </div>
          <p data-i18n="assessment-choose-honestly">{translations['assessment-choose-honestly'].en}</p>
        </header>
        <div class="assessment-progress" aria-hidden="true"><span id="assessmentProgress"></span></div>
        <p id="assessmentScenario" class="assessment-scenario"></p>
        <h2 id="assessmentQuestion" tabindex="-1"></h2>
        <div id="assessmentOptions" class="assessment-options"></div>
        <aside id="assessmentFeedback" class="assessment-feedback" aria-live="polite" hidden>
          <strong data-i18n="assessment-feedback-title">{translations['assessment-feedback-title'].en}</strong>
          <p id="assessmentFeedbackText"></p>
        </aside>
        <nav class="assessment-navigation" aria-label="Assessment question controls">
          <button id="assessmentPrevious" type="button" data-i18n="assessment-previous">{translations['assessment-previous'].en}</button>
          <button id="assessmentNext" type="button" class="assessment-next" disabled>{translations['assessment-next'].en}</button>
        </nav>
      </section>

      <section id="assessmentResults" class="assessment-results" tabindex="-1" aria-labelledby="assessmentResultsTitle" hidden>
        <p class="assessment-eyebrow" data-i18n="assessment-results-eyebrow">{translations['assessment-results-eyebrow'].en}</p>
        <h2 id="assessmentResultsTitle" data-i18n="assessment-results-title">{translations['assessment-results-title'].en}</h2>
        <p id="assessmentScore" class="assessment-score"></p>
        <p id="assessmentResultMessage" class="assessment-result-message"></p>
        <div class="assessment-summary">
          <div id="assessmentStrongest"></div>
          <div id="assessmentFocus"></div>
        </div>
        <a id="assessmentFocusLink" class="btn btn-green assessment-focus-link" href="/modules"></a>
        <section class="assessment-domain-section" aria-labelledby="assessmentDomainsTitle">
          <h3 id="assessmentDomainsTitle" data-i18n="assessment-domain-title">{translations['assessment-domain-title'].en}</h3>
          <div id="assessmentDomainResults" class="assessment-domain-results"></div>
        </section>
        <section class="assessment-review-section" aria-labelledby="assessmentReviewTitle">
          <h3 id="assessmentReviewTitle" data-i18n="assessment-review-title">{translations['assessment-review-title'].en}</h3>
          <div id="assessmentReview" class="assessment-review"></div>
        </section>
        <div class="assessment-result-actions">
          <button id="assessmentRetake" type="button" class="btn btn-outline" data-i18n="assessment-retake">{translations['assessment-retake'].en}</button>
          <a href="/modules" class="btn btn-green" data-i18n="assessment-explore">{translations['assessment-explore'].en}</a>
        </div>
      </section>
    </section>

    <noscript><p class="assessment-noscript">JavaScript is required for this interactive self-assessment. The learning modules remain available without it.</p></noscript>
  </main>
</BaseLayout>

<script>
  import '@scripts/self-assessment';
</script>